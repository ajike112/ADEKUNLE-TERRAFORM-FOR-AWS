pipeline {
    agent { label 'docker-agent' }

    environment {
        AWS_REGION      = "us-east-1"
        ECR_ACCOUNT_ID  = "536697262404"
        ECR_REPO        = "jenkins-app-repo"
        ECR_URL         = "${ECR_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO}"
        SONARQUBE_ENV   = "SonarQube"
        SONAR_TOKEN     = credentials('sonar-token')
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Conditional Cleanup (Disk < 5GB)') {
            steps {
                script {
                    def freeMB = sh(
                        script: "df -m / | awk 'NR==2 {print \$4}'",
                        returnStdout: true
                    ).trim() as Integer

                    echo "Free disk space: ${freeMB} MB"

                    if (freeMB < 5000) {
                        echo "Disk space below 5GB — running cleanup..."

                        sh '''
                            docker image prune -f
                            docker container prune -f
                            docker volume prune -f
                            docker builder prune -af
                            rm -rf /home/ubuntu/jenkins/workspace/*@tmp || true
                            echo "Cleanup complete."
                        '''
                    } else {
                        echo "Disk space is healthy — skipping cleanup."
                    }
                }
            }
        }

        stage('Build & Unit Tests') {
            steps {
                dir('web-bank-app') {
                    sh '''
                        echo "Installing dependencies and running tests..."
                        npm install
                        npm test
                    '''
                }
            }
        }

        stage('OWASP Dependency Check') {
            steps {
                withCredentials([string(credentialsId: 'nvd-api-key', variable: 'NVD_API_KEY')]) {
                    sh '''
                        echo "Running OWASP Dependency Check with full updates..."

                        rm -rf dependency-check-report
                        mkdir -p dependency-check-report
                        mkdir -p ${WORKSPACE}/odc-data

                        export JAVA_OPTS="-Xmx2g"

                        /opt/dependency-check/bin/dependency-check.sh \
                          --project jenkins-app \
                          --scan web-bank-app \
                          --exclude node_modules \
                          -f HTML \
                          -f XML \
                          --out dependency-check-report \
                          --data ${WORKSPACE}/odc-data \
                          --suppression ${WORKSPACE}/web-bank-app/dependency-check-suppression.xml \
                          --nvdApiKey $NVD_API_KEY \
                          --disableOssIndex

                        echo "OWASP scan completed"
                    '''
                }
            }
        }

        stage('SonarQube SAST') {
            steps {
                dir('web-bank-app') {
                    withSonarQubeEnv('SonarQube') {
                        sh '''
                            echo "Running SonarQube scan..."
                            export PATH=/opt/sonar-scanner/bin:$PATH

                            sonar-scanner \
                              -Dsonar.projectKey=web-bank-app \
                              -Dsonar.sources=. \
                              -Dsonar.host.url=http://sonarqube-dev-alb-1370244034.us-east-1.elb.amazonaws.com \
                              -Dsonar.login=$SONAR_TOKEN
                        '''
                    }
                }
            }
        }

        stage('SonarQube Quality Gate') {
            options {
                timeout(time: 10, unit: 'MINUTES')
            }
            steps {
                waitForQualityGate abortPipeline: true
            }
        }

        stage('Trivy Scan (Filesystem)') {
            steps {
                sh '''
                    echo "Running Trivy filesystem scan..."
                    trivy fs --exit-code 1 --severity HIGH,CRITICAL .
                '''
            }
        }

        stage('Docker Build') {
            steps {
                script {
                    env.IMAGE_TAG = "${env.BUILD_NUMBER}"

                    sh '''
                        echo "Building Docker image..."
                        docker build -t ${ECR_REPO}:${IMAGE_TAG} web-bank-app
                    '''
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh '''
                    echo "Running Trivy image scan..."
                    trivy image --exit-code 0 --severity CRITICAL --ignore-unfixed --scanners vuln ${ECR_REPO}:${IMAGE_TAG}
                '''
            }
        }

        stage('Push to ECR') {
            steps {
                sh '''
                    echo "Logging into ECR..."
                    aws ecr get-login-password --region ${AWS_REGION} | \
                      docker login --username AWS --password-stdin ${ECR_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com

                    echo "Tagging image..."
                    docker tag ${ECR_REPO}:${IMAGE_TAG} ${ECR_URL}:${IMAGE_TAG}

                    echo "Pushing image to ECR..."
                    docker push ${ECR_URL}:${IMAGE_TAG}
                '''
            }
        }

    } 

        stage('Update Helm Values & Trigger CD') {
            steps {
                script {
                    echo "Updating Helm values file with new image tag..."

                    // Path to your dev or prod overlay
                    def valuesFile = "web-bank-app/helm/overlays/dev/values-dev.yaml"

                    // Replace the tag line with the new BUILD_NUMBER
                    sh """
                        sed -i 's/tag:.*/tag: "dev-${BUILD_NUMBER}"/' ${valuesFile}
                    """

                    echo "Committing updated Helm values file..."

                    sh """
                        git config user.email "jenkins@ci"
                        git config user.name "Jenkins CI"

                        git add ${valuesFile}
                        git commit -m "CI/CD: Update image tag to dev-${BUILD_NUMBER}"
                        git push origin master
                    """

                    echo "GitOps CD triggered — ArgoCD will sync automatically."
                }
            }
        }


    post {

        always {
            archiveArtifacts artifacts: 'dependency-check-report/**',
                             fingerprint: true,
                             allowEmptyArchive: true
        }

        success {
            echo "CI pipeline completed successfully. Image tag: ${env.IMAGE_TAG}"

            mail to: 'adekunleajike@gmail.com',
                 subject: "Jenkins Pipeline SUCCESS — Build #${env.BUILD_NUMBER}",
                 body: """
Hello Adekunle,

Your Jenkins CI pipeline completed successfully.

Image Tag: ${env.IMAGE_TAG}
Repository: ${ECR_REPO}

OWASP Report (HTML):
${env.BUILD_URL}artifact/dependency-check-report/dependency-check-report.html

Regards,
Jenkins CI/CD
"""
        }

        failure {
            echo "CI pipeline failed. Check OWASP, SonarQube, or Trivy results."

            mail to: 'adekunleajike@gmail.com',
                 subject: "Jenkins Pipeline FAILURE — Build #${env.BUILD_NUMBER}",
                 body: """
Hello Adekunle,

Your Jenkins CI pipeline FAILED.

Please review the following stages:
- OWASP Dependency Check
- SonarQube SAST & Quality Gate
- Trivy Filesystem Scan
- Trivy Image Scan

OWASP Report (HTML):
${env.BUILD_URL}artifact/dependency-check-report/dependency-check-report.html

Regards,
Jenkins CI/CD
"""
        }
    }
}
