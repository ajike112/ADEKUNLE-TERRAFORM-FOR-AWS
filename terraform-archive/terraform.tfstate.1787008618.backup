            "status": "failed",
            "timeout": 300,
            "upgrade_install": null,
            "values": [
              "loki:\r\n  auth_enabled: false\r\n\r\n  server:\r\n    http_listen_port: 3100\r\n\r\n  memberlist:\r\n    join_members:\r\n      - loki-loki-distributed-memberlist\r\n\r\n  distributor:\r\n    ring:\r\n      kvstore:\r\n        store: memberlist\r\n\r\n  ingester:\r\n    lifecycler:\r\n      ring:\r\n        kvstore:\r\n          store: memberlist\r\n    chunk_idle_period: 5m\r\n    chunk_retain_period: 30s\r\n    max_transfer_retries: 0\r\n\r\n  schema_config:\r\n    configs:\r\n      - from: \"2024-04-01\"\r\n        store: tsdb\r\n        object_store: aws\r\n        schema: v13\r\n        index:\r\n          prefix: index_\r\n          period: 24h\r\n\r\n  storage_config:\r\n    aws:\r\n      s3:\r\n        bucketnames:\r\n          - mybucket-ajike\r\n        region: us-east-1\r\n\r\n    tsdb_shipper:\r\n      active_index_directory: /var/loki/index\r\n      cache_location: /var/loki/cache\r\n      shared_store: s3\r\n\r\n  limits_config:\r\n    ingestion_rate_mb: 10\r\n    ingestion_burst_size_mb: 20\r\n"
