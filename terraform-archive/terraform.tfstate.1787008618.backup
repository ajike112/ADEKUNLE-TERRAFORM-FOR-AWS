            "metadata": [
              {
                "app_version": "2.9.13",
                "chart": "loki-distributed",
                "first_deployed": 1787007629,
                "last_deployed": 1787007629,
                "name": "loki",
                "namespace": "logging",
                "notes": "***********************************************************************\n Welcome to Grafana Loki\n Chart version: 0.80.6\n Loki version: 2.9.13\n***********************************************************************\n\nInstalled components:\n* gateway\n* ingester\n* distributor\n* querier\n* query-frontend\n",
                "revision": 1,
                "values": "{\"loki\":{\"auth_enabled\":false,\"distributor\":{\"ring\":{\"kvstore\":{\"store\":\"memberlist\"}}},\"ingester\":{\"chunk_idle_period\":\"5m\",\"chunk_retain_period\":\"30s\",\"lifecycler\":{\"ring\":{\"kvstore\":{\"store\":\"memberlist\"}}},\"max_transfer_retries\":0},\"limits_config\":{\"ingestion_burst_size_mb\":20,\"ingestion_rate_mb\":10},\"memberlist\":{\"join_members\":[\"loki-loki-distributed-memberlist\"]},\"schema_config\":{\"configs\":[{\"from\":\"2024-04-01\",\"index\":{\"period\":\"24h\",\"prefix\":\"index_\"},\"object_store\":\"aws\",\"schema\":\"v13\",\"store\":\"tsdb\"}]},\"server\":{\"http_listen_port\":3100},\"storage_config\":{\"aws\":{\"s3\":{\"bucketnames\":[\"mybucket-ajike\"],\"region\":\"us-east-1\"}},\"tsdb_shipper\":{\"active_index_directory\":\"/var/loki/index\",\"cache_location\":\"/var/loki/cache\",\"shared_store\":\"s3\"}}}}",
                "version": "0.80.6"
              }
            ],
            "name": "loki",
            "namespace": "logging",
            "pass_credentials": false,
            "postrender": [],
            "recreate_pods": false,
            "render_subchart_notes": true,
            "replace": false,
            "repository": "https://grafana.github.io/helm-charts",
